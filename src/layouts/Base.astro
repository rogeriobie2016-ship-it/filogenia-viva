---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';

const { titulo, descricao, prancha } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tituloPagina = titulo ? `${titulo} · Filogenia Viva` : 'Filogenia Viva';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#ddd0b6" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <!-- retículas e hachuras usadas pelas ilustrações -->
    <svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0">
      <defs>
        <pattern id="ha1" width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(38)"><line x1="0" y1="0" x2="0" y2="3.2" stroke="#16130e" stroke-width=".45" /></pattern>
        <pattern id="ha2" width="1.9" height="1.9" patternUnits="userSpaceOnUse" patternTransform="rotate(38)"><line x1="0" y1="0" x2="0" y2="1.9" stroke="#16130e" stroke-width=".55" /></pattern>
        <pattern id="hax" width="2.3" height="2.3" patternUnits="userSpaceOnUse" patternTransform="rotate(-52)"><line x1="0" y1="0" x2="0" y2="2.3" stroke="#16130e" stroke-width=".5" /></pattern>
        <pattern id="hb" width="2.7" height="2.7" patternUnits="userSpaceOnUse" patternTransform="rotate(28)"><circle cx="1.35" cy="1.35" r=".74" fill="#16130e" /></pattern>
        <pattern id="escamas" width="56" height="40" patternUnits="userSpaceOnUse"><path d="M0,20 Q28,-6 56,20 M-28,40 Q0,14 28,40 M28,40 Q56,14 84,40 M-28,0 Q0,-26 28,0 M28,0 Q56,-26 84,0" fill="none" stroke="#16130e" stroke-width="1.5" /></pattern>
      </defs>
    </svg>

    <header class="cabeca">
      <div class="wrap">
        <a class="marca" href={base}>Filogenia Viva</a>
        {prancha && <p class="leg">{prancha}</p>}
      </div>
      <!-- as costelas do ninho da caba-tatu, que lembram a carapaça do tatu -->
      <svg class="escamas" aria-hidden="true"><rect width="100%" height="100%" fill="#c7b594" /><rect width="100%" height="100%" fill="url(#escamas)" /></svg>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="wrap">
        <p class="caps">Filogenia Viva · projeto em concepção e prototipagem, 2026</p>
        <p>Árvore simplificada para divulgação, com base em Peters et al. (2017). Ilustrações originais do projeto, desenhadas em SVG.</p>
      </div>
    </footer>
  </body>
</html>
